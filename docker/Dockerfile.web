# syntax=docker/dockerfile:1
# This pinned SDK is AMD64-only. Only the compiler stage uses emulation on Apple Silicon;
# its WASM output is portable, and Node/nginx/API run natively on ARM64.
ARG WASM_BUILD_PLATFORM=linux/amd64
FROM --platform=${WASM_BUILD_PLATFORM} emscripten/emsdk:6.0.12 AS wasm-build
WORKDIR /src
COPY CMakeLists.txt ./
COPY engine ./engine
RUN emcmake cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build -j2

FROM node:22-bookworm-slim AS web-dependencies
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM web-dependencies AS web-dev
COPY web ./
COPY --from=wasm-build /src/build/dsp.js /src/build/dsp.wasm ./public/
EXPOSE 5173
CMD ["npm", "run", "dev"]

FROM web-dev AS web-build
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.28-alpine AS web
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /app/dist /usr/share/nginx/html
EXPOSE 8080

FROM web-dependencies AS browser-tools
RUN npx playwright install --with-deps chromium

FROM browser-tools AS web-test
COPY web ./
COPY --from=wasm-build /src/build/dsp.js /src/build/dsp.wasm ./public/
CMD ["npm", "run", "test:e2e"]
